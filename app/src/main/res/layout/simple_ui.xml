<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    android:focusable="false"
    tools:ignore="HardcodedText">

    <!-- red pulsing border, positioned at runtime to hug the real preview rect -->
    <View
        android:id="@+id/sc_rec_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/sc_vf_frame_rec"
        android:alpha="0"
        android:clickable="false"
        android:visibility="gone" />

    <!-- settings (storage folder) button, top-right -->
    <ImageView
        android:id="@+id/sc_settings"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="38dp"
        android:layout_marginEnd="16dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/sc_ic_settings"
        android:background="@drawable/sc_circle_btn"
        android:contentDescription="設定儲存資料夾"
        android:clickable="true"
        android:focusable="true" />

    <!-- ===== bottom floating controls (overlaid on full-screen preview, no black backing) ===== -->
    <LinearLayout
        android:id="@+id/sc_camera_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="22dp"
        android:clickable="true">

        <!-- shutter: independent, centered, above the other three -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/sc_shutter"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:text="拍照"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#14150F"
                android:background="@drawable/sc_shutter_photo"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>

        <!-- one row, same height: gallery | 拍照/錄影 pill | flip -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingLeft="18dp"
            android:paddingRight="18dp">

            <FrameLayout
                android:id="@+id/sc_gallery"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/sc_sq_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/sc_gallery_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="3dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="照片" />

                <TextView
                    android:id="@+id/sc_gallery_label"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="照片"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFF" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/sc_mode_pill"
                android:padding="5dp">

                <TextView
                    android:id="@+id/sc_tab_photo"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="72dp"
                    android:gravity="center"
                    android:text="拍照"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/sc_tab_selected"
                    android:textColor="#14150F" />

                <TextView
                    android:id="@+id/sc_tab_video"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="72dp"
                    android:layout_marginStart="5dp"
                    android:gravity="center"
                    android:text="錄影"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#99FFFFFF" />
            </LinearLayout>

            <ImageView
                android:id="@+id/sc_flip"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="end|center_vertical"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/sc_ic_reload"
                android:contentDescription="切換前後鏡頭"
                android:background="@drawable/sc_sq_button"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>
    </LinearLayout>

    <!-- ===== recording controls (only a stop button, aligned to shutter height) ===== -->
    <LinearLayout
        android:id="@+id/sc_recording_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="94dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/sc_stop"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/sc_stop_outer"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/sc_stop_inner" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="停止"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== white flash overlay ===== -->
    <View
        android:id="@+id/sc_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:alpha="0"
        android:clickable="false"
        android:visibility="gone" />

    <!-- ===== tuck (save) animation square, sized/positioned at runtime ===== -->
    <FrameLayout
        android:id="@+id/sc_tuck"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@drawable/sc_tuck_overlay"
        android:clickable="false"
        android:visibility="gone" />

    <!-- ===== recording timer capsule, positioned at runtime near preview top ===== -->
    <LinearLayout
        android:id="@+id/sc_rec_capsule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="66dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/sc_rec_capsule"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:clickable="false"
        android:visibility="gone">

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/sc_white_dot" />

        <TextView
            android:id="@+id/sc_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</FrameLayout>
