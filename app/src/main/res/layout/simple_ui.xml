<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    android:focusable="false"
    tools:ignore="HardcodedText">

    <!-- red pulsing border, positioned at runtime to hug the real preview rect -->
    <View
        android:id="@+id/sc_rec_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/sc_vf_frame_rec"
        android:alpha="0"
        android:clickable="false"
        android:visibility="gone" />

    <!-- ===== bottom floating controls (iPhone-style, over the preview) ===== -->
    <LinearLayout
        android:id="@+id/sc_camera_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/sc_bottom_scrim"
        android:paddingTop="14dp"
        android:paddingBottom="26dp"
        android:clickable="true">

        <!-- mode toggle pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal"
            android:background="@drawable/sc_mode_pill"
            android:padding="5dp">

            <TextView
                android:id="@+id/sc_tab_photo"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:minWidth="90dp"
                android:gravity="center"
                android:text="拍照"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/sc_tab_selected"
                android:textColor="#14150F" />

            <TextView
                android:id="@+id/sc_tab_video"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:minWidth="90dp"
                android:layout_marginStart="5dp"
                android:gravity="center"
                android:text="錄影"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#99FFFFFF" />
        </LinearLayout>

        <!-- control row: shutter centered, gallery left, flip right -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="18dp"
            android:paddingRight="18dp">

            <FrameLayout
                android:id="@+id/sc_gallery"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/sc_sq_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/sc_gallery_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="3dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="照片" />

                <TextView
                    android:id="@+id/sc_gallery_label"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="照片"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFF" />
            </FrameLayout>

            <TextView
                android:id="@+id/sc_shutter"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:text="拍照"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#14150F"
                android:background="@drawable/sc_shutter_photo"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/sc_flip"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="end|center_vertical"
                android:gravity="center"
                android:text="前"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF"
                android:background="@drawable/sc_sq_button" />
        </FrameLayout>
    </LinearLayout>

    <!-- ===== recording controls (only a stop button) ===== -->
    <LinearLayout
        android:id="@+id/sc_recording_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/sc_bottom_scrim"
        android:paddingTop="14dp"
        android:paddingBottom="26dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/sc_stop"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/sc_stop_outer"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/sc_stop_inner" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="停止"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== white flash overlay ===== -->
    <View
        android:id="@+id/sc_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:alpha="0"
        android:clickable="false"
        android:visibility="gone" />

    <!-- ===== tuck (save) animation square, sized/positioned at runtime ===== -->
    <FrameLayout
        android:id="@+id/sc_tuck"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@drawable/sc_tuck_overlay"
        android:clickable="false"
        android:visibility="gone" />

    <!-- ===== recording timer capsule, positioned at runtime near preview top ===== -->
    <LinearLayout
        android:id="@+id/sc_rec_capsule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="66dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/sc_rec_capsule"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:clickable="false"
        android:visibility="gone">

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/sc_white_dot" />

        <TextView
            android:id="@+id/sc_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</FrameLayout>
